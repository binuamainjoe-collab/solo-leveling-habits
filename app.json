{
  "expo": {
    "name": "The System",
    "slug": "solo-leveling-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "system",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#110D0A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thesystem.app"
    },
    "android": {
      "package": "com.thesystem.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#110D0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#110D0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to hear you when you talk to The System."
        }
      ],
      "expo-notifications",
      "expo-image",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
