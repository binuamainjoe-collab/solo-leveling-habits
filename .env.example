# The nightly briefing's planner. Copy this file to `.env.local` and fill both
# in, then restart Metro (EXPO_PUBLIC_* values are inlined at build time, so a
# hot reload will not pick them up).
#
# Neither value is a secret once the web app is deployed: anything prefixed
# EXPO_PUBLIC_ is compiled into the bundle and readable in devtools. That is
# why the real protection is server-side — the edge function holds the Gemini
# key and enforces a hard 30-calls-a-day cap of its own.
#
# Leave them unset and the briefing simply never offers itself; everything else
# in the app works unchanged.

EXPO_PUBLIC_PLANNER_URL=https://<project-ref>.supabase.co/functions/v1/plan-tomorrow

# Must match the APP_SECRET secret set on the edge function.
EXPO_PUBLIC_APP_SECRET=

# ---------------------------------------------------------------- accounts
#
# Google sign-in and cross-device sync. Unset, the app runs exactly as it did
# before accounts existed: local-only, one profile, no sign-in button.
#
# The anon key is meant to be public — it is only useful alongside row-level
# security, which every table has switched on. The Google client secret and
# refresh tokens never appear here; the edge functions hold those.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
